generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ORGANIZATION_MANAGER
  DEPARTMENT_MANAGER
  EMPLOYEE
  VIEWER
}

enum PrincipalStatus {
  ACTIVE
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  REMOVED
}

enum AccessLevel {
  OWNER
  ORGANIZATION_MANAGER
  DEPARTMENT_HEAD
  MEMBER
  VIEWER
}

enum UserAccountStatus {
  ACTIVE
  SUSPENDED
  ACCESS_REMOVED
}

enum InvitationStatus {
  PENDING_OWNER_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum AccessAuditAction {
  PERSON_CREATED
  PERSON_ARCHIVED
  ORGANIZATION_MEMBERSHIP_ADDED
  ORGANIZATION_MEMBERSHIP_REMOVED
  DEPARTMENT_MEMBERSHIP_CHANGED
  TEAM_MEMBERSHIP_CHANGED
  ACCESS_REQUESTED
  INVITATION_APPROVED
  INVITATION_SENT
  INVITATION_RESENT
  INVITATION_ACCEPTED
  INVITATION_REJECTED
  INVITATION_CANCELLED
  ACCESS_LEVEL_CHANGED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  ACCESS_REMOVED
  SESSIONS_REVOKED
  ACCOUNT_CREATED
  USERNAME_CHANGED
  PASSWORD_RESET
  PASSWORD_CHANGED
}

enum PrincipalType {
  PERSON
  TEAM
}

enum TaskStatus {
  READY
  IN_PROGRESS
  WAITING
  BLOCKED
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssignmentRole {
  PRIMARY_OWNER
  COLLABORATOR
}

enum AssignmentSource {
  MANUAL
  DEPARTMENT_ROUTING
  SMART_INBOX
  CLAIM
  IMPORT
}

enum NextActionKind {
  PRINCIPAL
  DEPARTMENT
  EXTERNAL
  READY
}

enum DependencyType {
  START_BLOCKER
  COMPLETION_BLOCKER
  RELATED
}

enum ReviewDecision {
  APPROVED
  REVISION_REQUESTED
}

enum ResourceScope {
  TASK
  PROJECT
  ORGANIZATION
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  OWNER
  MEMBER
  COLLABORATOR
}

enum MilestoneStatus {
  PLANNED
  DONE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  MONTHS
}

enum CaptureStatus {
  NEEDS_ORGANIZATION
  REVIEWING
  CONFIRMED
  UNDONE
}

enum WorkflowTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum NudgeDisposition {
  DISMISSED
  SNOOZED
}

enum TaskEventType {
  CREATED
  TITLE_CHANGED
  ORGANIZATION_CHANGED
  LEAD_DEPARTMENT_CHANGED
  INVOLVED_DEPARTMENTS_CHANGED
  ASSIGNED
  CLAIMED
  REASSIGNED
  NEXT_ACTION_CHANGED
  DATES_CHANGED
  STATUS_CHANGED
  WAITING_MARKED
  BLOCKED_MARKED
  DEPENDENCY_CHANGED
  UPDATE_POSTED
  REVIEW_SUBMITTED
  REVIEW_APPROVED
  REVISION_REQUESTED
  COMPLETED
  REOPENED
  ARCHIVED
  IMPORTED
}

model Workspace {
  id                String             @id @default(uuid())
  name              String
  revision          Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organizations     Organization[]
  principals        Principal[]
  tasks             Task[]
  projects          Project[]
  captures          InboxCapture[]
  legacyImports     LegacyImport[]
  taskRecurrences   TaskRecurrence[]
  savedViews        SavedView[]
  workflowTemplates WorkflowTemplate[]
  nudgeStates       WorkNudge[]
  preferences       PrincipalPreference[]
}

model Organization {
  id                String                @id @default(uuid())
  workspaceId       String
  name              String
  description       String?
  /// Semantic Binnie palette key. UI themes resolve this key to their own tokens.
  colorKey          String                @default("powderBlue")
  aliases           String[]              @default([])
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  departments       Department[]
  projects          Project[]
  memberships       PrincipalMembership[]
  accessMemberships OrganizationMembership[]
  teamScopes        TeamScope[]
  invitations       Invitation[]
  accessAuditLogs   AccessAuditLog[]
  tasks             Task[]
  resources         TaskResource[]
  workflowTemplates WorkflowTemplate[]

  @@unique([workspaceId, name])
}

model Department {
  id                   String                               @id @default(uuid())
  organizationId       String
  name                 String
  aliases              String[]                             @default([])
  organization         Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships          PrincipalMembership[]
  accessMemberships    DepartmentMembership[]
  teamScopes           TeamScope[]
  leadTasks            Task[]                               @relation("LeadDepartment")
  involvedTasks        TaskInvolvedDepartment[]
  nextActionTasks      Task[]                               @relation("NextActionDepartment")
  dependencyOwners     TaskDependency[]                     @relation("DependencyOwnerDepartment")
  leadProjects         Project[]                            @relation("ProjectLeadDepartment")
  projectInvolvement   ProjectInvolvedDepartment[]
  templateLeadTasks    WorkflowTemplateTask[]               @relation("TemplateTaskLeadDepartment")
  templateLeadProjects WorkflowTemplate[]                   @relation("TemplateLeadDepartment")
  templateInvolvement  WorkflowTemplateInvolvedDepartment[]

  @@unique([organizationId, name])
}

model Project {
  id                   String                      @id @default(uuid())
  workspaceId          String
  organizationId       String
  leadDepartmentId     String?
  name                 String
  description          String?
  targetDate           DateTime?                   @db.Date
  status               ProjectStatus               @default(ACTIVE)
  createdByPrincipalId String?
  sourceTemplateId     String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  workspace            Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadDepartment       Department?                 @relation("ProjectLeadDepartment", fields: [leadDepartmentId], references: [id], onDelete: SetNull)
  createdBy            Principal?                  @relation("ProjectCreator", fields: [createdByPrincipalId], references: [id], onDelete: SetNull)
  involvedDepartments  ProjectInvolvedDepartment[]
  members              ProjectMember[]
  milestones           ProjectMilestone[]
  focusItems           ProjectFocusItem[]
  tasks                Task[]
  resources            TaskResource[]
  sourceTemplate       WorkflowTemplate?           @relation("TemplateProjects", fields: [sourceTemplateId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@index([workspaceId, status])
  @@index([leadDepartmentId])
  @@index([sourceTemplateId])
}

model ProjectInvolvedDepartment {
  projectId    String
  departmentId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([projectId, departmentId])
  @@index([departmentId, projectId])
}

model ProjectMember {
  id          String            @id @default(uuid())
  projectId   String
  principalId String
  role        ProjectMemberRole @default(MEMBER)
  addedAt     DateTime          @default(now())
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  principal   Principal         @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@unique([projectId, principalId])
  @@index([principalId, role])
}

model ProjectMilestone {
  id               String          @id @default(uuid())
  projectId        String
  title            String
  targetDate       DateTime?       @db.Date
  status           MilestoneStatus @default(PLANNED)
  ownerPrincipalId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner            Principal?      @relation(fields: [ownerPrincipalId], references: [id], onDelete: SetNull)

  @@index([projectId, targetDate])
}

model ProjectFocusItem {
  id        String   @id @default(uuid())
  projectId String
  text      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, position])
}

model Principal {
  id                         String                      @id @default(uuid())
  workspaceId                String
  type                       PrincipalType
  name                       String
  jobTitle                   String?
  email                      String?
  phone                      String?
  notes                      String?
  active                     Boolean                     @default(true)
  status                     PrincipalStatus             @default(ACTIVE)
  workspace                  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userAccount                UserAccount?
  organizationMemberships    OrganizationMembership[]
  departmentMemberships      DepartmentMembership[]
  teamMemberships            TeamMembership[]            @relation("PersonTeamMembership")
  teamMemberMemberships      TeamMembership[]            @relation("TeamMember")
  teamScopes                 TeamScope[]                 @relation("TeamScope")
  invitationPerson           Invitation[]                @relation("InvitationPerson")
  requestedInvitations       Invitation[]                @relation("InvitationRequester")
  approvedInvitations        Invitation[]                @relation("InvitationApprover")
  rejectedInvitations        Invitation[]                @relation("InvitationRejector")
  accessAuditActor           AccessAuditLog[]            @relation("AccessAuditActor")
  accessAuditTarget          AccessAuditLog[]            @relation("AccessAuditTarget")
  memberships                PrincipalMembership[]
  preferences                PrincipalPreference?
  assignments                TaskAssignment[]            @relation("AssignedPrincipal")
  assignedBy                 TaskAssignment[]            @relation("AssignedByPrincipal")
  createdTasks               Task[]                      @relation("TaskCreator")
  createdProjects            Project[]                   @relation("ProjectCreator")
  projectMemberships         ProjectMember[]
  milestoneOwnership         ProjectMilestone[]
  nextActionTasks            Task[]                      @relation("NextActionPrincipal")
  dependencyOwners           TaskDependency[]            @relation("DependencyOwnerPrincipal")
  submittedReviews           TaskReviewCycle[]           @relation("SubmittedBy")
  requestedReviews           TaskReviewCycle[]           @relation("ReviewRequestedFrom")
  reviewedReviews            TaskReviewCycle[]           @relation("ReviewedBy")
  updates                    TaskUpdate[]
  events                     TaskEvent[]
  captures                   InboxCapture[]
  completedChecklistItems    TaskChecklistItem[]
  savedViews                 SavedView[]
  createdTemplates           WorkflowTemplate[]          @relation("TemplateCreator")
  templateAssignments        WorkflowTemplateTask[]      @relation("TemplateTaskAssignee")
  templateMilestoneOwnership WorkflowTemplateMilestone[]
  nudgeStates                WorkNudge[]

  @@unique([workspaceId, name])
}

// Personal settings are deliberately separate from identity and memberships so
// preference migrations never replace user-created profile data.
model PrincipalPreference {
  principalId    String   @id
  workspaceId    String
  timezone       String   @default("Asia/Jakarta")
  dateFormat     String   @default("12 Aug 2026")
  theme          String   @default("soft")
  taskListColumns Json?
  storageVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  principal      Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// LEGACY COMPATIBILITY ONLY: its departmentId was backfilled into
// DepartmentMembership by 20260826113000_multi_user_access_foundation. New
// application reads and writes use OrganizationMembership,
// DepartmentMembership, TeamMembership, and TeamScope exclusively. Retire
// this model/table only in a later verified cleanup migration.
model PrincipalMembership {
  id             String        @id @default(uuid())
  principalId    String
  organizationId String?
  departmentId   String?
  role           WorkspaceRole @default(EMPLOYEE)
  principal      Principal     @relation(fields: [principalId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([principalId, organizationId, departmentId])
}

// Canonical Person-to-organization affiliation. A NULL accessLevel means the
// Person is in the directory only and cannot gain Binnie access accidentally.
model OrganizationMembership {
  id          String           @id @default(uuid())
  personId    String
  organizationId String
  accessLevel AccessLevel?
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  removedAt   DateTime?
  person      Principal        @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([personId, organizationId])
  @@index([organizationId, status, accessLevel])
}

// The only canonical Person-to-department affiliation after the legacy
// PrincipalMembership.departmentId compatibility window is retired.
model DepartmentMembership {
  id           String           @id @default(uuid())
  personId     String
  departmentId String
  status       MembershipStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  removedAt    DateTime?
  person       Principal        @relation(fields: [personId], references: [id], onDelete: Cascade)
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([personId, departmentId])
  @@index([departmentId, status])
}

// Person-to-team affiliation. Teams continue to use Principal(type=TEAM), so
// task assignment IDs and historical records remain unchanged.
model TeamMembership {
  id        String           @id @default(uuid())
  personId  String
  teamId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  removedAt DateTime?
  person    Principal        @relation("PersonTeamMembership", fields: [personId], references: [id], onDelete: Cascade)
  team      Principal        @relation("TeamMember", fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([personId, teamId])
  @@index([teamId, status])
}

// Team scope is intentionally separate from a Person's department membership.
// It preserves the existing team-to-organization/department routing data.
model TeamScope {
  id             String           @id @default(uuid())
  teamId         String
  organizationId String
  departmentId   String?
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  removedAt      DateTime?
  team           Principal        @relation("TeamScope", fields: [teamId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([teamId, organizationId, departmentId])
  @@index([organizationId, departmentId, status])
}

model UserAccount {
  id                   String            @id @default(uuid())
  authUserId           String            @unique
  personId             String            @unique
  // Login credentials belong to the account, never to the Person name. The
  // normalized value is the case-insensitive unique login key; username keeps
  // the Owner-approved display spelling for account administration.
  username             String?
  usernameNormalized   String?           @unique
  // Legacy compatibility only. This may retain an old magic-link email, but
  // is optional and is never consulted for username/password authentication.
  loginEmailNormalized String?           @unique
  status               UserAccountStatus @default(ACTIVE)
  requiresPasswordChange Boolean         @default(true)
  temporaryPasswordExpiresAt DateTime?
  passwordChangedAt    DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  lastLoginAt          DateTime?
  suspendedAt          DateTime?
  accessRemovedAt      DateTime?
  authUser             AuthUser          @relation(fields: [authUserId], references: [id], onDelete: Restrict)
  person               Principal         @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId, status])
  @@index([usernameNormalized, status])
}

// A single record covers both a Manager access request and the delivered
// workspace invitation. It never represents directory affiliation.
model Invitation {
  id                  String           @id @default(uuid())
  personId            String
  organizationId      String
  // Retained solely to preserve previously issued email invitations. New
  // account requests do not require an email and use requestedUsername.
  emailNormalized     String?
  requestedUsername   String?
  requestedUsernameNormalized String?
  approvedUsername    String?
  approvedUsernameNormalized String?
  requestedAccessLevel AccessLevel
  approvedAccessLevel AccessLevel?
  status              InvitationStatus @default(PENDING_OWNER_APPROVAL)
  requestedById       String
  approvedById        String?
  rejectedById        String?
  rejectionReason     String?
  tokenHash           String?
  tokenVersion        Int              @default(0)
  expiresAt           DateTime?
  sentAt              DateTime?
  acceptedAt          DateTime?
  cancelledAt         DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  person              Principal        @relation("InvitationPerson", fields: [personId], references: [id], onDelete: Restrict)
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy         Principal        @relation("InvitationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy          Principal?       @relation("InvitationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy          Principal?       @relation("InvitationRejector", fields: [rejectedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([personId, status])
  @@index([emailNormalized, status])
  @@index([requestedUsernameNormalized, status])
}

// Better Auth's own shared database-backed request rate limiter. This protects
// the public credential endpoint by source IP; Binnie's additional throttle
// below also keys failures by normalized username plus source IP.
model AuthRateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Short-lived failed credential counters. The IP is hashed before persistence;
// this table is not an account directory and is never exposed to clients.
model CredentialLoginThrottle {
  id                 String   @id @default(uuid())
  usernameNormalized String
  ipAddressHash      String
  failureCount       Int      @default(0)
  windowStartedAt    DateTime @default(now())
  blockedUntil       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([usernameNormalized, ipAddressHash])
  @@index([blockedUntil])
}

model AccessAuditLog {
  id            String            @id @default(uuid())
  actorPersonId String?
  targetPersonId String?
  organizationId String?
  action        AccessAuditAction
  before        Json?
  after         Json?
  metadata      Json?
  createdAt     DateTime          @default(now())
  actor         Principal?        @relation("AccessAuditActor", fields: [actorPersonId], references: [id], onDelete: SetNull)
  target        Principal?        @relation("AccessAuditTarget", fields: [targetPersonId], references: [id], onDelete: SetNull)
  organization  Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([targetPersonId, createdAt])
}

// Better Auth core records. Their names are explicitly configured in
// src/lib/auth.ts so they cannot collide with Binnie's domain identity.
model AuthUser {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      AuthSession[]
  accounts      AuthAccount[]
  userAccount   UserAccount?
}

model AuthSession {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String   @id @default(uuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Task {
  id                      String                   @id @default(uuid())
  workspaceId             String
  organizationId          String?
  leadDepartmentId        String?
  projectId               String?
  parentTaskId            String?
  sourceTaskId            String?
  recurrenceId            String?
  mergedIntoTaskId        String?
  createdByPrincipalId    String?
  title                   String
  description             String?
  status                  TaskStatus               @default(READY)
  priority                TaskPriority             @default(MEDIUM)
  startDate               DateTime?                @db.Date
  targetDate              DateTime?                @db.Date
  deadline                DateTime?                @db.Date
  followUpDate            DateTime?                @db.Date
  waitingSince            DateTime?
  nextActionKind          NextActionKind           @default(READY)
  nextActionPrincipalId   String?
  nextActionDepartmentId  String?
  nextActionExternalLabel String?
  // Estimates are deliberately optional. `estimatedMinutes` is the planned
  // effort for the task as a whole; it is never multiplied for shared work.
  // `actualMinutes` is reserved for a future, opt-in time-tracking workflow.
  estimatedMinutes        Int?
  actualMinutes           Int?
  version                 Int                      @default(1)
  legacyLocalId           String?
  archivedAt              DateTime?
  deletedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization            Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  leadDepartment          Department?              @relation("LeadDepartment", fields: [leadDepartmentId], references: [id], onDelete: SetNull)
  project                 Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentTask              Task?                    @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks                Task[]                   @relation("TaskHierarchy")
  sourceTask              Task?                    @relation("TaskSplitSource", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  splitTasks              Task[]                   @relation("TaskSplitSource")
  recurrence              TaskRecurrence?          @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  createdBy               Principal?               @relation("TaskCreator", fields: [createdByPrincipalId], references: [id], onDelete: SetNull)
  nextActionPrincipal     Principal?               @relation("NextActionPrincipal", fields: [nextActionPrincipalId], references: [id], onDelete: SetNull)
  nextActionDepartment    Department?              @relation("NextActionDepartment", fields: [nextActionDepartmentId], references: [id], onDelete: SetNull)
  involvedDepartments     TaskInvolvedDepartment[]
  assignments             TaskAssignment[]
  dependencies            TaskDependency[]         @relation("DependentTask")
  prerequisiteFor         TaskDependency[]         @relation("PrerequisiteTask")
  updates                 TaskUpdate[]
  resources               TaskResource[]
  events                  TaskEvent[]
  reviewCycles            TaskReviewCycle[]
  checklistItems          TaskChecklistItem[]
  captureLinks            CaptureTask[]
  nudgeStates             WorkNudge[]

  @@unique([workspaceId, legacyLocalId])
  @@index([workspaceId, status, archivedAt, deletedAt])
  @@index([organizationId, leadDepartmentId])
  @@index([projectId])
  @@index([parentTaskId])
  @@index([sourceTaskId])
  @@index([recurrenceId])
}

model TaskChecklistItem {
  id                     String     @id @default(uuid())
  taskId                 String
  title                  String
  position               Int        @default(0)
  completedAt            DateTime?
  completedByPrincipalId String?
  task                   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy            Principal? @relation(fields: [completedByPrincipalId], references: [id], onDelete: SetNull)

  @@unique([taskId, position])
  @@index([taskId, completedAt])
}

model TaskRecurrence {
  id                 String              @id @default(uuid())
  workspaceId        String
  frequency          RecurrenceFrequency
  interval           Int                 @default(1)
  weekDays           Int[]               @default([])
  monthDay           Int?
  startDate          DateTime            @db.Date
  endDate            DateTime?           @db.Date
  nextOccurrenceDate DateTime?           @db.Date
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks              Task[]

  @@index([workspaceId, active, nextOccurrenceDate])
}

model SavedView {
  id          String     @id @default(uuid())
  workspaceId String
  ownerId     String?
  name        String
  filters     Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       Principal? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
  @@index([workspaceId, ownerId])
}

model TaskInvolvedDepartment {
  taskId       String
  departmentId String
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([taskId, departmentId])
  @@index([departmentId, taskId])
}

model TaskAssignment {
  id                      String           @id @default(uuid())
  taskId                  String
  principalId             String
  role                    AssignmentRole   @default(COLLABORATOR)
  source                  AssignmentSource @default(MANUAL)
  assignedAt              DateTime         @default(now())
  assignedByPrincipalId   String?
  claimedFromAssignmentId String?
  task                    Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  principal               Principal        @relation("AssignedPrincipal", fields: [principalId], references: [id], onDelete: Cascade)
  assignedBy              Principal?       @relation("AssignedByPrincipal", fields: [assignedByPrincipalId], references: [id], onDelete: SetNull)
  claimedFrom             TaskAssignment?  @relation("ClaimLineage", fields: [claimedFromAssignmentId], references: [id], onDelete: SetNull)
  claims                  TaskAssignment[] @relation("ClaimLineage")

  @@unique([taskId, principalId])
  @@index([principalId, role])
}

model TaskDependency {
  id                 String         @id @default(uuid())
  taskId             String
  prerequisiteTaskId String?
  ownerPrincipalId   String?
  ownerDepartmentId  String?
  type               DependencyType
  label              String
  resolvedAt         DateTime?
  createdAt          DateTime       @default(now())
  task               Task           @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisiteTask   Task?          @relation("PrerequisiteTask", fields: [prerequisiteTaskId], references: [id], onDelete: SetNull)
  ownerPrincipal     Principal?     @relation("DependencyOwnerPrincipal", fields: [ownerPrincipalId], references: [id], onDelete: SetNull)
  ownerDepartment    Department?    @relation("DependencyOwnerDepartment", fields: [ownerDepartmentId], references: [id], onDelete: SetNull)

  @@index([taskId, type, resolvedAt])
  @@index([prerequisiteTaskId])
}

model TaskReviewCycle {
  id                     String          @id @default(uuid())
  taskId                 String
  submittedByPrincipalId String
  submittedAt            DateTime        @default(now())
  reviewerPrincipalId    String?
  reviewedByPrincipalId  String?
  reviewedAt             DateTime?
  decision               ReviewDecision?
  revisionNote           String?
  task                   Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy            Principal       @relation("SubmittedBy", fields: [submittedByPrincipalId], references: [id], onDelete: Restrict)
  reviewer               Principal?      @relation("ReviewRequestedFrom", fields: [reviewerPrincipalId], references: [id], onDelete: SetNull)
  reviewedBy             Principal?      @relation("ReviewedBy", fields: [reviewedByPrincipalId], references: [id], onDelete: SetNull)

  @@index([taskId, reviewedAt])
}

model TaskUpdate {
  id        String         @id @default(uuid())
  taskId    String
  authorId  String
  text      String
  createdAt DateTime       @default(now())
  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    Principal      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  resources TaskResource[]

  @@index([taskId, createdAt])
}

model TaskResource {
  id             String        @id @default(uuid())
  scope          ResourceScope
  taskId         String?
  projectId      String?
  organizationId String?
  updateId       String?
  label          String
  url            String?
  fileName       String?
  mimeType       String?
  byteSize       Int?
  content        Bytes?
  createdAt      DateTime      @default(now())
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  update         TaskUpdate?   @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@index([taskId, scope])
  @@index([updateId])
}

model TaskEvent {
  id        String        @id @default(uuid())
  taskId    String
  actorId   String?
  type      TaskEventType
  summary   String
  before    Json?
  after     Json?
  createdAt DateTime      @default(now())
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     Principal?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model InboxCapture {
  id              String        @id @default(uuid())
  workspaceId     String
  actorId         String?
  rawText         String
  status          CaptureStatus @default(REVIEWING)
  candidates      Json?
  confirmationKey String?
  undoExpiresAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor           Principal?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tasks           CaptureTask[]

  @@index([workspaceId, status])
}

model CaptureTask {
  captureId String
  taskId    String
  capture   InboxCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([captureId, taskId])
}

model LegacyImport {
  id            String    @id @default(uuid())
  workspaceId   String
  fingerprint   String
  importedAt    DateTime  @default(now())
  importedCount Int
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, fingerprint])
}

// Phase 3 keeps reusable workflows canonical. A template is intentionally a
// lightweight project blueprint: it can suggest work, teams, checklists and
// simple dependency links without becoming a separate task system.
model WorkflowTemplate {
  id                   String                               @id @default(uuid())
  workspaceId          String
  organizationId       String
  leadDepartmentId     String?
  createdByPrincipalId String?
  name                 String
  description          String?
  status               WorkflowTemplateStatus               @default(ACTIVE)
  createdAt            DateTime                             @default(now())
  updatedAt            DateTime                             @updatedAt
  workspace            Workspace                            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization         Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadDepartment       Department?                          @relation("TemplateLeadDepartment", fields: [leadDepartmentId], references: [id], onDelete: SetNull)
  createdBy            Principal?                           @relation("TemplateCreator", fields: [createdByPrincipalId], references: [id], onDelete: SetNull)
  involvedDepartments  WorkflowTemplateInvolvedDepartment[]
  tasks                WorkflowTemplateTask[]
  milestones           WorkflowTemplateMilestone[]
  focusItems           WorkflowTemplateFocusItem[]
  projects             Project[]                            @relation("TemplateProjects")

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@index([organizationId])
}

model WorkflowTemplateInvolvedDepartment {
  templateId   String
  departmentId String
  template     WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([templateId, departmentId])
  @@index([departmentId, templateId])
}

model WorkflowTemplateTask {
  id                 String                          @id @default(uuid())
  templateId         String
  title              String
  description        String?
  leadDepartmentId   String?
  defaultAssigneeId  String?
  priority           TaskPriority                    @default(MEDIUM)
  startOffsetDays    Int?
  targetOffsetDays   Int?
  deadlineOffsetDays Int?
  position           Int                             @default(0)
  template           WorkflowTemplate                @relation(fields: [templateId], references: [id], onDelete: Cascade)
  leadDepartment     Department?                     @relation("TemplateTaskLeadDepartment", fields: [leadDepartmentId], references: [id], onDelete: SetNull)
  defaultAssignee    Principal?                      @relation("TemplateTaskAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  checklistItems     WorkflowTemplateChecklistItem[]
  dependencies       WorkflowTemplateDependency[]    @relation("TemplateDependentTask")
  prerequisiteFor    WorkflowTemplateDependency[]    @relation("TemplatePrerequisiteTask")

  @@unique([templateId, position])
  @@index([templateId, leadDepartmentId])
}

model WorkflowTemplateChecklistItem {
  id             String               @id @default(uuid())
  templateTaskId String
  title          String
  position       Int                  @default(0)
  templateTask   WorkflowTemplateTask @relation(fields: [templateTaskId], references: [id], onDelete: Cascade)

  @@unique([templateTaskId, position])
}

model WorkflowTemplateDependency {
  id                         String               @id @default(uuid())
  taskId                     String
  prerequisiteTemplateTaskId String
  type                       DependencyType
  label                      String
  task                       WorkflowTemplateTask @relation("TemplateDependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisiteTask           WorkflowTemplateTask @relation("TemplatePrerequisiteTask", fields: [prerequisiteTemplateTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, prerequisiteTemplateTaskId, type])
  @@index([prerequisiteTemplateTaskId])
}

model WorkflowTemplateMilestone {
  id               String           @id @default(uuid())
  templateId       String
  title            String
  targetOffsetDays Int?
  ownerPrincipalId String?
  position         Int              @default(0)
  template         WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  owner            Principal?       @relation(fields: [ownerPrincipalId], references: [id], onDelete: SetNull)

  @@unique([templateId, position])
}

model WorkflowTemplateFocusItem {
  id         String           @id @default(uuid())
  templateId String
  text       String
  position   Int              @default(0)
  template   WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
}

// Nudge state records a deliberate dismissal or snooze. The actual nudge
// candidates remain derived from live work, so resolved work disappears on its
// own and no background process needs to create noisy notifications.
model WorkNudge {
  id           String           @id @default(uuid())
  workspaceId  String
  recipientId  String
  taskId       String?
  dedupKey     String
  disposition  NudgeDisposition
  snoozedUntil DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient    Principal        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  task         Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, recipientId, dedupKey])
  @@index([workspaceId, recipientId, disposition])
  @@index([taskId])
}

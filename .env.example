# PostgreSQL is Binnie's only persistence layer.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=app_binnie_system"

# Better Auth owns password hashing, sessions, and session revocation.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-production-secret"
BINNIE_MULTI_USER_AUTH_ENABLED="false"

# First controlled Owner bootstrap. This must be the stable existing Person
# ID, never a name. Run `npm run auth:bootstrap-owner` after setting both
# values; it links/reuses an AuthUser and UserAccount for that existing Person
# only and prints a one-time temporary password when provisioning is needed.
BINNIE_OWNER_PERSON_ID="person-charlotte"
BINNIE_OWNER_USERNAME="charlotte"
# Set true only to deliberately rotate the Owner's temporary password, then
# reset it to false. Normal repeated bootstrap runs preserve the credential.
BINNIE_OWNER_PASSWORD_RESET="false"

# Optional for future notifications/recovery; authentication does not require
# Resend, a verified sender, or a Person contact email.
RESEND_API_KEY=""
BINNIE_EMAIL_FROM="Binnie <access@example.com>"
